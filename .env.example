# FLASHNOVA Environment Configuration
SECRET_KEY=flashnova-futuristic-super-secret-key-change-in-production
FLASK_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Configuration (SQLite default for local, PostgreSQL for Render/Production)
# DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///flashnova.db

# QR Token Lifetime (seconds)
QR_EXPIRY_SECONDS=10

# CORS Allowed Origins (Comma separated or *)
CORS_ORIGINS=*

# Configurable Subject Access Codes
MAT121_CODE=MAT121
CHM131_CODE=CHM131
WSP111_CODE=WSP111
